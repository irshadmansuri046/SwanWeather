# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/weatherdb

# Application Configuration
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Configuration
RAW_GRIB_STORAGE_DIR=/data/raw_grib
USE_LOCAL_STORAGE=true # Set to false to upload directly to Supabase Storage
ECMWF_DATA_SOURCE=azure # Source to download GRIB data from: aws, azure, ecmwf

# Data Retention
RETENTION_DAYS=2 # Number of days of GRIB files & DB forecasts to retain (e.g. 2, 30)
